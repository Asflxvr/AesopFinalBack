@using AesopFinal.Areas.AdminPanel.ViewModels.CreateVM
@model CategoryCreateVm

<div>
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Create Category form</h4>
                <p class="card-description"></p>
                    <form class="forms-sample" method="post">
                        <div asp-validation-summary="All"></div>
                        <div class="form-group">
                            <label asp-for="categoryName">Category Name</label>
                            <input asp-for="categoryName" class=" form-control" placeholder="Name">
                            <span asp-validation-for="categoryName" class="text-danger"></span>
                        </div>

                    <button type="submit" class="btn btn-primary me-2" asp-area="AdminPanel" asp-action="Create" asp-controller="Category">Submit</button>
                        <button class="btn btn-light" asp-action="Index" asp-controller="Category">Cancel</button>
                    </form>
            </div>
        </div>
    </div>
</div>

