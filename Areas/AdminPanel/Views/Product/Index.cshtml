@model IEnumerable<Product>
@{
	int count = 1;
}

<div class="row">
	<div class="col-lg-12 grid-margin stretch-card">
		<div class="card">
			<div class="card-body">
				<h4 class="card-title">Product table</h4>
				<a class="btn btn-primary" asp-action="Create" asp-controller="Product">Create</a>
				<div class="table-responsive pt-3">
					<table class="table table-dark">
						<thead>
							<tr>
								<th>
									Count
								</th>
								<th>
									Title
								</th>
								<th>
									Description
								</th>
								<th>
									Category
								</th>
								<th>
									Price
								</th>
								<th>
									Image
								</th>
								<th>
									SecondaryImage
								</th>
								<th>
									Size
								</th>
								<th>
									Settings
								</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var item in Model)
							{
								<tr>
									<td>
										@count
									</td>
									<td>
										@item.Title
									</td>
									<td>
										@item.Description
									</td>
									<td>
										@(item.Category != null ? item.Category.CategoryName : "Kategori mövcud deyil")
									</td>
									<td>
										$@item.Price
									</td>
									<td>
										<img src="~/assets/images/@item.ImageURL" alt="@item.Title" />
									</td>
									<td>
										<img src="~/assets/images/@item.SecondaryImageURL" alt="@item.Title" />
									</td>
									<td>
										@item.GetActualSize()
									</td>
									<td>
										<a type="button" class="btn btn-warning" asp-action="Update" asp-controller="Product" asp-route-id="@item.Id">Update</a>
										@if (item.IsDeleted)
										{
											<a class="btn btn-info" asp-controller="Product"
											   asp-action="Activate"
											   asp-route-id="@item.Id" style="background-color:#17a2b8; border-color:#17a2b8;">Activate</a>
										}
										else
										{
											<a class="btn btn-danger"
											   asp-area="AdminPanel"
											   asp-controller="Product"
											   asp-action="Delete"
											   asp-route-id="@item.Id">Delete</a>
										}
										
									</td>
								</tr>
								count++;
							}

						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>