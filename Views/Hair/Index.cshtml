@model IEnumerable<Product>
@{
    Layout = "_SecondaryLayout";
}


<main>
    <!-- hairhero -->
    <section class="hero-banner">
        <div class="hero-content">
            <h1 class="hero-title">Hair</h1>
            <p class="hero-text">
                Our approach to hair care is honest and straightforward:
                a healthy scalp is-quite literally-the foundation of lustrous, resilient hair.
            </p>
        </div>
    </section>
    <!-- haircards -->
    <section class="product-section">
        <div class="product-grid">

            <article class="product-card">
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Category_Page_2024_Hair_Secondary_Grid_Shampoo_Conditioner-mobile.png"
                         alt="Shampoo & Conditioner">
                </div>
                <h3 class="product-title">Shampoo & Conditioner</h3>
            </article>

            <article class="product-card">
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Category_Page_Hair_Subcat_Menu_Treatments_1080x1080px.jpg"
                         alt="Treatments">
                </div>
                <h3 class="product-title">Treatments</h3>
            </article>

            <article class="product-card">
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Category_Page_Hair_Subcat_Menu_Grooming_1080x1080px.jpg"
                         alt="Grooming">
                </div>
                <h3 class="product-title">Grooming</h3>
            </article>

        </div>
    </section>
    <!-- ucluhand -->
    <section class="notable-formulations">
        <h2 class="section-title">Notable formulations</h2>

        <div class="product-grid">
            @foreach (var item in Model)
            {

                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/@item.ImageURL"
                             alt="Rose Hair">
                        <button class="bookmark-btn">
                            <svg width="14" height="19" viewBox="0 0 14 19" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M1 1V17L7 13L13 17V1H1Z" stroke="black" />
                            </svg>
                        </button>
                    </div>
                    <div class="product-info">
                        <h3 class="product-name">@item.Title</h3>
                        <p class="product-desc">@item.Description</p>
                        <span class="product-price">@item.Price</span>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div>
            }
        </div>
    </section>
    <!-- face -->
    <section class="assistance-section">
        <div class="assistance-container">
            <div class="info-content">
                <h2 class="title">For additional assistance</h2>
                <p class="description">
                    If you could use some guidance finding the ideal formulation for your individual needs,
                    our consultants are available to help at a distance.
                </p>
                <a href="#" class="consult-btn">
                    Speak to a real consultant <span class="arrow">→</span>
                </a>
            </div>

            <div class="image-box">
                <img src="./assets/images/Aesop_Category_Page_All_Secondary_3_Assistance_Mobile_640x640px.jpg"
                     alt="Skincare Consultation" class="consultant-img">
            </div>
        </div>
    </section>
</main>
