@{
    Layout = "_SecondaryLayout";
}


<main>
    <!-- herohand -->
    <section class="category-banner">
        <div class="banner-container">
            <div class="banner-content">
                <h1 class="banner-title">Hand & Body</h1>
                <p class="banner-description">
                    All of our formulations for body and hand-whether their purpose is to
                    effectively cleanse, hydrate or address matters of personal care-are
                    intended to enrich otherwise ordinary experiences.
                </p>
            </div>
        </div>
    </section>
    <!-- handcard -->
    <section class="product-gallery">
        <div class="product-item">
            <div class="product-image">
                <img src="./assets/images/Aesop_Category_Page_Hand_Body_Subcat_Menu_Hand_Washes_Balms_1080x1080px.jpg"
                     alt="Hand Washes & Balms">
            </div>
            <h3 class="product-title">Hand Washes & Balms</h3>
        </div>

        <div class="product-item">
            <div class="product-image">
                <img src="./assets/images/Aesop_Category_Page_Hand_Body_Subcat_Menu_Bar_Soaps_1080x1080px.jpg"
                     alt="Bar Soaps">
            </div>
            <h3 class="product-title">Bar Soaps</h3>
        </div>

        <div class="product-item">
            <div class="product-image">
                <img src="./assets/images/Aesop_Category_Page_Hand_Body_Subcat_Menu_Body_Cleansers_Scrubs_1080x1080px.jpg"
                     alt="Body Cleansers & Scrubs">
            </div>
            <h3 class="product-title">Body Cleansers & Scrubs</h3>
        </div>

        <div class="product-item">
            <div class="product-image">
                <img src="./assets/images/Aesop_Category_Page_Hand_Body_Subcat_Menu_Body_Balms_Oils_1080x1080px.jpg"
                     alt="Body Balms & Oils">
            </div>
            <h3 class="product-title">Body Balms & Oils</h3>
        </div>

        <div class="product-item">
            <div class="product-image">
                <img src="./assets/images/Aesop_Category_Page_Hand_Body_Subcat_Menu_Oral_Care_and_Deodorants_1080x1080px.jpg"
                     alt="Oral Care & Deodorants">
            </div>
            <h3 class="product-title">Oral Care & Deodorants</h3>
        </div>
    </section>
    <!-- outofstock -->
    <section class="gift-kits">
        <header class="section-header">
            <p class="subtitle">Seasonal Gift Kits</p>
            <h2 class="title">For all rooms and recipients</h2>
            <p class="description">An abundant collection of Gift Kits inspired by the home.</p>
        </header>

        <div class="product-grid">
            <div class="product-card out-of-stock">
                <div class="card-top">
                    <span class="badge">New addition</span>
                    <button class="save-btn"><i class="fa-regular fa-bookmark"></i></button>
                </div>
                <div class="product-image">
                    <img src="./assets/images/Aesop_Kits_Gift_Kits_2025-26_Greetings_in_the_Guestroom_GL_NGL_Baseline_2000x2000px.png"
                         alt="Greetings in the Guest Room">
                </div>
                <div class="product-info">
                    <h3 class="item-name">Greetings in the Guest Room</h3>
                    <p class="item-desc">Two treasured hand and body care formulations</p>
                    <p class="item-price">$52.00</p>
                </div>
                <button class="add-btn" disabled>Out of stock</button>
            </div>

            <div class="product-card">
                <div class="card-top">
                    <span class="badge">New addition</span>
                    <button class="save-btn"><i class="fa-regular fa-bookmark"></i></button>
                </div>
                <div class="product-image">
                    <img src="./assets/images/Aesop_Kits_Gift_Kits_2025-26_Shower_Room_Serenades_GL_NGL_Baseline_2000x2000px.png"
                         alt="Shower Room Serenades">
                </div>
                <div class="product-info">
                    <h3 class="item-name">Shower Room Serenades</h3>
                    <p class="item-desc">A pair of Eleos formulations ideal for dry hands and bodies</p>
                    <p class="item-price">$65.00</p>
                </div>
                <button class="add-btn">Add to cart</button>
            </div>

            <div class="product-card">
                <div class="card-top">
                    <span class="badge">New addition</span>
                    <button class="save-btn"><i class="fa-regular fa-bookmark"></i></button>
                </div>
                <div class="product-image">
                    <img src="./assets/images/Aesop_Kits_Gift_Kits_2025-26_Too_Many_Cooks_in_the_Kitchen_GL_NGL_Baseline_2000x2000px.png"
                         alt="Too Many Cooks In the Kitchen">
                </div>
                <div class="product-info">
                    <h3 class="item-name">Too Many Cooks In the Kitchen</h3>
                    <p class="item-desc">Three sink-side staples for the hands</p>
                    <p class="item-price">$96.00</p>
                </div>
                <button class="add-btn">Add to cart</button>
            </div>
        </div>
    </section>
    <!-- purplesection -->
    <section class="feature-split">
        <div class="visual-side">
            <img src="./assets/images/Aesop_Category_Page_Hand_Body_Secondary_1_Eleos_1440x2000px.jpg"
                 alt="Eleos Texture">
        </div>
        <div class="content-side">
            <div class="text-content">
                <p class="tagline">Hydrating with performance</p>
                <h2 class="title">New Eleos Nourishing Body Cleanser</h2>
                <p class="desc">
                    Introducing a gentle, hydrating cleanser that leaves even dry skin feeling soft,
                    supple-and
                    refreshed.
                </p>
            </div>

            <div class="mini-card">
                <div class="card-meta">
                    <span class="label">New addition</span>
                    <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                </div>
                <div class="image-container hover-effect">
                    <img src="./assets/images/Aesop_Body_Eleos_Nourishing_Body_Cleanser_180mL_Tube_Front_2000x2000px.png"
                         alt="Bottle Front" class="img-primary">
                    <img src="./assets/images/Aesop_Body_Eleos_Nourishing_Body_Cleanser_Texture_2000x2000px.png"
                         alt="Bottle Hover" class="img-secondary">
                </div>
                <div class="mini-info">
                    <h3>Eleos Nourishing Body Cleanser</h3>
                    <span class="price">$38.00</span>
                </div>
                <button class="cart-btn">Add to cart</button>
            </div>
        </div>
    </section>
    <!-- recent -->
    <section class="recent-additions">
        <div class="container">
            <header class="section-header">
                <h2 class="title">Recent additions and revered formulations</h2>
            </header>

            <div class="slider-wrapper">
                <button class="nav-btn prev" id="prevBtn" aria-label="Previous">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.5">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>

                <div class="slider-container" id="slider">
                    <article class="product-card">
                        <div class="card-meta">
                            <span class="label">Beloved formulation</span>
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="image-box">
                            <img src="./assets/images/Aesop_Body_Geranium_Leaf_Body_Cleanser_500mL_Web_Front_2000x2000px (1).png"
                                 alt="Resurrection Aromatique Hand Balm">
                        </div>
                        <div class="product-info">
                            <h3>Resurrection Aromatique Hand Balm</h3>
                            <p>Citrus, woody, herbaceous</p>
                            <span class="price">$105.00</span>
                        </div>
                        <button class="cart-btn">Add to cart</button>
                    </article>

                    <article class="product-card">
                        <div class="card-meta">
                            <span class="label">Beloved formulation</span>
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="image-box">
                            <img src="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_500mL_Web_Front_2000x2000px.jpg"
                                 alt="Geranium Leaf Body Cleanser">
                        </div>
                        <div class="product-info">
                            <h3>Geranium Leaf Body Cleanser</h3>
                            <p>Green, citrus, fresh</p>
                            <span class="price">$55.00</span>
                        </div>
                        <button class="cart-btn">Add to cart</button>
                    </article>

                    <article class="product-card">
                        <div class="card-meta">
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="image-box">
                            <img src="./assets/images/Aesop_Hand_Eleos_Aromatique_Hand_Balm_75mL_Web_Front_A_2000x2000px.png"
                                 alt="Eleos Aromatique Hand Balm">
                        </div>
                        <div class="product-info">
                            <h3>Eleos Aromatique Hand Balm</h3>
                            <p>Herbaceous, woody, spicy</p>
                            <span class="price">$35.00</span>
                        </div>
                        <button class="cart-btn">Add to cart</button>
                    </article>

                    <article class="product-card">
                        <div class="card-meta">
                            <span class="label">New addition</span>
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="image-box">
                            <img src="./assets/images/Aesop_Body_Geranium_Leaf_Body_Scrub_180mL_Web_Front_2000x2000px.png"
                                 alt="Product 4">
                        </div>
                        <div class="product-info">
                            <h3>Body Cleanser Formulation</h3>
                            <p>Fresh, woody, herbaceous</p>
                            <span class="price">$45.00</span>
                        </div>
                        <button class="cart-btn">Add to cart</button>
                    </article>

                    <article class="product-card">
                        <div class="card-meta">
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="image-box">
                            <img src="./assets/images/Aesop_Personal_Care_Herbal_Deodorant_50mL_Web_Front_2000x2000px.png"
                                 alt="Product 5">
                        </div>
                        <div class="product-info">
                            <h3>Classic Hand Balm</h3>
                            <p>Citrus, fresh, herbaceous</p>
                            <span class="price">$33.00</span>
                        </div>
                        <button class="cart-btn">Add to cart</button>
                    </article>
                </div>

                <button class="nav-btn next" id="nextBtn" aria-label="Next">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.5">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </button>
            </div>

            <div class="slider-progress">
                <div class="bar-bg">
                    <div class="bar-fill" id="progressBar"></div>
                </div>
            </div>
        </div>
    </section>
    <!-- discover -->
    <section class="aromatic-cta">
        <div class="cta-content">
            <p class="tagline">Rigorously aromatic Personal Care</p>
            <h2 class="title">For you-and those within nose-shot</h2>
            <p class="description">
                If you would like more guidance finding a formulation, our consultants are available to help via live
                assistance.
            </p>
            <a href="#" class="cta-link">
                Discover the formulations
                <span class="arrow">→</span>
            </a>
        </div>
    </section>
    <!-- resurrection -->
    <section class="hand-wash-comparison">
        <div class="comparison-column resurrection">
            <div class="column-header">
                <h2 class="title">Resurrection Aromatique Hand Wash</h2>
                <p class="description">
                    For many, this citrus, woody, herbaceous formulation is their first interaction with Aesop. It
                    cleanses
                    hands gently yet effectively, enhanced with Mandarin Rind, Rosemary Leaf and Cedar Atlas.
                </p>
            </div>

            <div class="product-display">
                <div class="meta-top">
                    <span class="label">Beloved formulation</span>
                    <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                </div>

                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Hand_Resurrection_Aromatique_Hand_Wash_500mL_Web_Front_2000x2000px.png"
                         alt="Front View" class="img-primary">
                    <img src="./assets/images/Aesop_Top_20_2025_PDP_Texture_Resurrection_Hand_Wash_2000x2000px (1).png"
                         alt="Texture View" class="img-secondary">
                </div>

                <div class="product-info">
                    <h3>Resurrection Aromatique Hand Wash</h3>
                    <span class="price">$47.00</span>
                </div>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>

        <div class="comparison-column reverence">
            <div class="column-header">
                <h2 class="title">Reverence Aromatique Hand Wash</h2>
                <p class="description">
                    Instantly recognisable by its grainy particles of finely milled Pumice, this woody, earthy, smoky
                    formulation is decidedly unorthodox. It gently exfoliates as it cleanses, leaving the hands feeling
                    soft
                    and supple.
                </p>
            </div>

            <div class="product-display">
                <div class="meta-top">
                    <span class="label">Beloved formulation</span>
                    <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                </div>

                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Hand_Reverence_Aromatique_Hand_Wash_500mL_Web_Front_2000x2000px.png"
                         alt="Front View" class="img-primary">
                    <img src="./assets/images/Aesop_Top_20_2025_PDP_Texture_Reverence_Hand_Wash_2000x2000px.png"
                         alt="Texture View" class="img-secondary">
                </div>

                <div class="product-info">
                    <h3>Reverence Aromatique Hand Wash</h3>
                    <span class="price">$47.00</span>
                </div>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>
    </section>
    <!-- soap -->
    <section class="bathing-connoisseur">
        <div class="container">
            <div class="image-section">
                <img src="./assets/images/Module-Bathing-Connoisseur-Mobile.jpg" alt="Aesop Bar Soaps" class="main-img">
            </div>

            <div class="text-section">
                <h2 class="section-title">For the bathing connoisseur</h2>
                <p class="section-desc">
                    Those well-practised in the art of washing may hone their craft further by exploring different formats
                    that cater to a variety of skin needs and aromatic preferences.
                </p>
            </div>
        </div>
    </section>
    <!-- soaps -->
    <section class="soap-grid">
        <div class="grid-container">
            <div class="soap-card">
                <button class="wishlist-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                </button>
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Body_Nurture_Bar_Soap_Web_Front_2000x2000px.png" alt="Nurture Bar Soap" class="img-primary">
                    <img src="./assets/images/Aesop_Body_Nurture_Bar_Soap_Web_Texture_2000x2000px.png" alt="Nurture Texture" class="img-secondary">
                </div>
                <div class="soap-info">
                    <h3 class="product-name">Nurture Bar Soap</h3>
                    <p class="product-type">Especially suited to dry skin</p>
                    <span class="price">$29.00</span>
                </div>
                <button class="add-to-cart">Add to cart</button>
            </div>

            <div class="soap-card">
                <button class="wishlist-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                </button>
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Body_Polish_Bar_Soap_Web_Front_2000x2000px.png" alt="Polish Bar Soap" class="img-primary">
                    <img src="./assets/images/Aesop_Body_Polish_Bar_Soap_Web_Texture_2000x2000px.png" alt="Polish Texture" class="img-secondary">
                </div>
                <div class="soap-info">
                    <h3 class="product-name">Polish Bar Soap</h3>
                    <p class="product-type">Especially suited to dry, patchy skin</p>
                    <span class="price">$29.00</span>
                </div>
                <button class="add-to-cart">Add to cart</button>
            </div>

            <div class="soap-card">
                <button class="wishlist-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                    </svg>
                </button>
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Body_Refresh_Bar_Soap_Web_Front_2000x2000px.png" alt="Refresh Bar Soap" class="img-primary">
                    <img src="./assets/images/Aesop_Body_Refresh_Bar_Soap_Web_Texture_2000x2000px.png" alt="Refresh Texture" class="img-secondary">
                </div>
                <div class="soap-info">
                    <h3 class="product-name">Refresh Bar Soap</h3>
                    <p class="product-type">Suited to most skin types</p>
                    <span class="price">$29.00</span>
                </div>
                <button class="add-to-cart">Add to cart</button>
            </div>
        </div>
    </section>
    <!-- face -->
    <section class="assistance-section">
        <div class="assistance-container">
            <div class="info-content">
                <h2 class="title">For additional assistance</h2>
                <p class="description">
                    If you could use some guidance finding the ideal formulation for your individual needs,
                    our consultants are available to help at a distance.
                </p>
                <a href="#" class="consult-btn">
                    Speak to a real consultant <span class="arrow">→</span>
                </a>
            </div>

            <div class="image-box">
                <img src="./assets/images/Aesop_Category_Page_All_Secondary_3_Assistance_Mobile_640x640px.jpg"
                     alt="Skincare Consultation" class="consultant-img">
            </div>
        </div>
    </section>
</main>