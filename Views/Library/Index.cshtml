
@{
	Layout = "_Layout";
}

<main>
    <section class="library-hero">
        <div class="hero-background">
            <img src="./assets/images/Aesop_NGL_Library_Thumbnail_Product_Philosophy_Mobile_1080x800px.jpg" alt="Aesop Library">
            <div class="overlay"></div>
        </div>
        <div class="hero-content">
            <span class="hero-tagline">The Athenaeum</span>
            <h1 class="hero-title">A treasury of ideas</h1>
            <p class="hero-description">
                Essays, interviews, and musings on subjects that have long captured our
                attention—from literature and architecture to the art of formulation.
            </p>
            <a href="#" class="hero-btn">Explore library <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
    </section>

    <!-- 2. FEATURED ARTICLES -->
    <section class="featured-articles">
        <div class="container">
            <div class="section-header">
                <h2>Featured articles</h2>
                <p>Recent writings from the Aesop archive</p>
            </div>
            <div class="articles-grid">
                <article class="article-card large">
                    <div class="article-image">
                        <img src="./assets/images/Aesop_Pride_2021_Web_Secondary_Queer_Library_Queen_6_Mid_Desktop_2560x1440px.jpg" alt="Understanding skin">
                        <span class="article-category">Skin Care</span>
                    </div>
                    <div class="article-content">
                        <h3>An introduction to skin types</h3>
                        <p class="article-excerpt">
                            A guide to understanding the unique characteristics of your skin—and
                            how
                            to care for it accordingly.
                        </p>
                        <div class="article-meta">
                            <span class="read-time">8 minute read</span>
                            <a href="#" class="read-more">Read <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </article>

                <article class="article-card">
                    <div class="article-image">
                        <img src="./assets/images/image.jpg" alt="Fragrance notes">
                        <span class="article-category">Fragrance</span>
                    </div>
                    <div class="article-content">
                        <h3>The poetry of scent</h3>
                        <p class="article-excerpt">Notes on composition, memory, and the art of perfumery.</p>
                        <div class="article-meta">
                            <span class="read-time">5 minute read</span>
                            <a href="#" class="read-more">Read <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </article>

                <article class="article-card">
                    <div class="article-image">
                        <img src="./assets/images/images (1).jpg" alt="Store architecture">
                        <span class="article-category">Architecture</span>
                    </div>
                    <div class="article-content">
                        <h3>Space and sensibility</h3>
                        <p class="article-excerpt">
                            How our stores are designed to exist harmoniously within their
                            surroundings.
                        </p>
                        <div class="article-meta">
                            <span class="read-time">6 minute read</span>
                            <a href="#" class="read-more">Read <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- 3. CATEGORIES & TOPICS - ŞƏKİLLƏRLƏ -->
    <section class="library-categories">
        <div class="container">
            <div class="categories-header">
                <h2>Browse by topic</h2>
            </div>
            <div class="categories-grid">
                <div class="category-card">
                    <div class="category-image">
                        <img src="./assets/images/711kG9Gax2L._AC_UF350,350_QL80_.jpg" alt="Ingredients">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-content">
                        <h3>Ingredients</h3>
                        <p>The stories behind botanicals and laboratory innovations</p>
                        <span class="article-count">24 articles</span>
                        <a href="#" class="category-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

                <div class="category-card">
                    <div class="category-image">
                        <img src="./assets/images/2017085_OS_N26_webimageland.jpg" alt="Architecture">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-content">
                        <h3>Architecture</h3>
                        <p>Store design, urban interventions, and spatial narratives</p>
                        <span class="article-count">18 articles</span>
                        <a href="#" class="category-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

                <div class="category-card">
                    <div class="category-image">
                        <img src="./assets/images/images (2).jpg" alt="Literature">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-content">
                        <h3>Literature</h3>
                        <p>Book recommendations, author interviews, and literary musings</p>
                        <span class="article-count">32 articles</span>
                        <a href="#" class="category-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>

                <div class="category-card">
                    <div class="category-image">
                        <img src="./assets/images/images (3).jpg" alt="Formulation">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-content">
                        <h3>Formulation</h3>
                        <p>Insights into product development and scientific inquiry</p>
                        <span class="article-count">21 articles</span>
                        <a href="#" class="category-link">Explore <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. LATEST RELEASES -->
    <section class="latest-releases">
        <div class="container">
            <div class="releases-header">
                <span class="releases-subtitle">New additions</span>
                <h2>Latest releases</h2>
            </div>
            <div class="releases-grid">
                <div class="release-card">
                    <div class="release-image">
                        <img src="./assets/images/images (4).jpg" alt="Sensorialist">
                    </div>
                    <div class="release-content">
                        <span class="release-date">March 2026</span>
                        <h3>Notes of a Sensorialist</h3>
                        <p class="release-desc">A collection of essays on the interplay between scent and memory.</p>
                        <a href="#" class="release-link">Read <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="release-card">
                    <div class="release-image">
                        <img src="./assets/images/images (5).jpg" alt="The Art of Slowness">
                    </div>
                    <div class="release-content">
                        <span class="release-date">February 2026</span>
                        <h3>The Art of Slowness</h3>
                        <p class="release-desc">Embracing ritual in an accelerated world.</p>
                        <a href="#" class="release-link">Read <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="release-card">
                    <div class="release-image">
                        <img src="./assets/images/AESOP-UK-ST.jpg" alt="Ingredient Stories">
                    </div>
                    <div class="release-content">
                        <span class="release-date">January 2026</span>
                        <h3>Ingredient Stories: Vetiver</h3>
                        <p class="release-desc">Tracing the journey of a foundational fragrance component.</p>
                        <a href="#" class="release-link">Read <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="release-card">
                    <div class="release-image">
                        <img src="./assets/images/Battersea-power-station-website-assets-resize-01-1600x1067px.jpg" alt="Store as Sanctuary">
                    </div>
                    <div class="release-content">
                        <span class="release-date">December 2025</span>
                        <h3>Store as Sanctuary</h3>
                        <p class="release-desc">The philosophy behind our retail spaces.</p>
                        <a href="#" class="release-link">Read <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
