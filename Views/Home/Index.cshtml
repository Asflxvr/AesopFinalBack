                    </div>

                    <!-- data-id EKLENDİ -->
                    <div class="product-item" data-id="resurrection-duet">
                        <div class="badge">New addition</div>
                        <div class="product-image">
                            <img src="./assets/images/Aesop_Kits_Resurrection_Duet_Web_Front_A_2000x2000px.png" class="main-img">
                            <img src="./assets/images/Aesop_Top_20_2025_PDP_Texture_Resurrection_Hand_Wash_2000x2000px.png"
                                 class="hover-img">
