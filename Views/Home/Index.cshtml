                    <span class="playBtn"><i class="fa-solid fa-pause"></i></span>
                    <span class="muteBtn"><i class="fa-solid fa-volume-xmark"></i></span>
                </div>
            </div>
        </section>
        <!-- newAndNotable -->
        <section class="new-notable">
            <div class="container">
                <div class="section-title">
                    <span>New and notable</span>
