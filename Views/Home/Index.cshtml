                    <div class="product-item" data-id="lucent-facial-refiner">
                        <div class="badge">New addition</div>
                        <div class="product-image">
                            <img src="./assets/images/Aesop_Skin_Lucent_Facial_Refiner_60mL_NGL_Front_2000x2000px.png"
                                 class="main-img">
                            <img src="./assets/images/Aesop_Skin_Lucent_Facial_Refiner_60mL_NGL_Use_2000x2000px.png"
                                 class="hover-img">
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="product-info">
                            <h4>Lucent Facial Refiner</h4>
                            <p class="desc">For normal to dry; dehydrated, dull skin</p>
                            <span class="size">2 fl oz</span>
                            <p class="price">$97.00</p>
                        </div>
                        <button class="add-to-cart">Add to cart</button>
                    </div>

                    <div class="product-item" data-id="aurner-eau-de-parfum">
                        <div class="badge">New addition</div>
                        <div class="product-image">
                            <img src="./assets/images/Aesop_Fragrance_Aurner_Eau_de_Parfum_50mL_Bottle_NGL_2000x2000px.png"
                                 class="main-img">
                            <img src="./assets/images/Aesop_Fragrance_Aurner_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png"
                                 class="hover-img">
