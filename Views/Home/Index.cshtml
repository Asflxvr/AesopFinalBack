                            <span class="size">1.6 fl oz</span>
                            <p class="price">$200.00</p>
                        </div>
                        <button class="add-to-cart">Add to cart</button>
                    </div>

                    <div class="product-item" data-id="geranium-body-treatment">
                        <div class="badge">New addition</div>
                        <div class="product-image">
                            <img src="./assets/images/Aesop_Body_Geranium_Leaf_Hydrating_Body_Treatment_Web_Front_2000x2000px.png"
                                 class="main-img">
                            <img src="./assets/images/Aesop_Geranium_Leaf_Hydrating_Body_Treatment_100mL-NGL_In-Situ_01_Product_2000x2000px.png"
                                 class="hover-img">
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="product-info">
                            <h4>Geranium Leaf Body Treatment</h4>
                            <p class="desc">Nourishing oil for soft, supple skin</p>
                            <span class="size">3.4 fl oz</span>
                            <p class="price">$50.00</p>
                        </div>
                        <button class="add-to-cart">Add to cart</button>
                    </div>
                </div>

                <button class="arrow next" id="nextBtn"><i class="fa-solid fa-chevron-right"></i></button>
            </div>

                <div class="slider-progress">
                    <div class="progress-bar" id="progressBar"></div>
                </div>
            </div>
        </section>
        <!-- discovergifts -->
        <section class="horse-section">
            <div class="horse-container">
                <div class="horse-content">
                    <span class="horse-label">Celebrating the Year of the Horse</span>
                    <h2 class="horse-title">Considered companions to the galloping rhythms of the day</h2>
                    <p class="horse-text">
                        Our latest offerings honour the spirit of new beginnings-an invitation to discover something singular for
                        the
                        year ahead.
                    </p>
                    <a href="#" class="horse-btn">
                        <span>Discover gifts</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>

                <div class="horse-video-wrapper">
                    <video id="horseVideo" autoplay muted loop playsinline class="horse-video">
                        <source src="./assets/videos/WhatsApp Video 2026-02-21 at 13.25.46.mp4" type="video/mp4">
                    </video>

                    <div class="video-controls">
                        <button id="playPauseBtn" class="control-btn">
                            <i class="fa-solid fa-pause" id="controlIcon"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>
        <!-- addtocarrt -->
        <section class="product-grid">

            <div class="product-card" data-id="lucent">

                <div class="image-wrapper">

                    <img src="./assets/images/Aesop_Skin_Lucent_Facial_Concentrate_60mL_Front_2000x2000px.jpg" class="main-img"
