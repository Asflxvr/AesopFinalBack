                    <img src="./assets/images/Aesop_Skin_Lucent_Facial_Concentrate_60mL_NGL_Texture_2000x2000px.jpg"
                         class="hover-img" alt="Lucent Hover Effect">

                </div>



                <div class="content">

                    <h3 class="product-title">Lucent Facial Concentrate</h3>

                    <p class="product-desc" style="justify-self:start; align-self:start;">For a wide range of skin types</p>



                    <div class="size-container">

                        <span class="size-label">Size</span>

                        <select class="size-select">

                            <option value="137.00">2.0 fl oz</option>

                            <option value="200.00">3.4 fl oz</option>

                        </select>

                    </div>



                    <p class="price">$<span class="val">137.00</span></p>



                    <button class="add-btn">

                        <span class="text">Add to cart</span>

                        <i class="fa-solid fa-spinner loader"></i>

                    </button>

                </div>

            </div>

            <div class="product-card" data-id="rind">

                <div class="image-wrapper">

                    <img src="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_100mL_Web_Front_B_2000x2000px.jpg"
                         class="main-img" alt="Rind Concentrate Body Balm">

                    <img src="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_100mL_Web_Front_A_2000x2000px.jpg"
                         class="hover-img" alt="Rind Hover Effect">

                </div>



                <div class="content">

                    <h3 class="product-title">Rind Concentrate Body Balm</h3>

                    <p class="product-desc">Citrus, fresh</p>



                    <div class="size-container">

                        <span class="size-label">Size</span>

                        <select class="size-select">

                            <option value="49.00"
                                    data-img="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_100mL_Web_Front_B_2000x2000px.jpg"
                                    data-hover="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_100mL_Web_Front_A_2000x2000px.jpg">

                                3.4 fl oz

                            </option>



                            <option value="107.00"
                                    data-img="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_500mL_Web_Front_2000x2000px.jpg"
                                    data-hover="./assets/images/Aesop_Body_Rind_Concentrate_Body_Balm_500mL_Web_Back_2000x2000px.jpg">

                                17 oz

                            </option>

                        </select>

                    </div>



                    <p class="price">$<span class="val">49.00</span></p>



                    <button class="add-btn">

                        <span class="text">Add to cart</span>

                        <i class="fa-solid fa-spinner loader"></i>

                    </button>

                </div>

            </div>



            <div class="product-card" data-id="geranium">

                <div class="image-wrapper">

                    <img src="./assets/images/Aesop_Geranium_Leaf_Hydrating_Body_Treatment_100mL-NGL_In-Situ_01_Product_2000x2000px.png"
                         class="main-img" alt="Geranium Leaf Duet">

                    <img src="./assets/images/Aesop_Geranium_Leaf_Body_Cleanser_500mL_NGL_In-Situ_02_Dosage_2000x2000px.png"
                         class="hover-img" alt="Geranium Hover Effect">

                </div>



                <div class="content">

                    <h3 class="product-title">Geranium Leaf Duet</h3>

                    <p class="product-desc">A green, citrus, fresh duo to cleanse and hydrate the body</p>



                    <div class="no-size-box">

                        <span class="one-size-text">One size only</span>

                        <span class="kit-text">Kit</span>

                    </div>



                    <p class="price">$147.00</p>



                    <button class="add-btn">

                        <span class="text">Add to cart</span>

                        <i class="fa-solid fa-spinner loader"></i>

                    </button>

                </div>

            </div>

        </section>
        <!-- browse -->
