                            <img src="./assets/images/skincare.jpg" alt="Skin Care">
                            <span>Skin Care</span>
                        </div>
                        <div class="category-card">
                            <img src="./assets/images/hand-and-body.jpg" alt="Hand & Body">
                            <span>Hand & Body</span>
                        </div>
                        <div class="category-card">
                            <img src="./assets/images/fragrance.jpg" alt="Fragrance">
                            <span>Fragrance</span>
                        </div>
                        <div class="category-card">
                            <img src="./assets/images/home.jpg" alt="Home">
                            <span>Home</span>
                        </div>
                        <div class="category-card">
                            <img src="./assets/images/hair.jpg" alt="Hair">
                            <span>Hair</span>
                        </div>
                        <div class="category-card">
                            <img src="./assets/images/travel.jpg" alt="Body Care">
                            <span>Body Care</span>
                        </div>
