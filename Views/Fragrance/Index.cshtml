@model IEnumerable<Product>
@{
	Layout = "_Layout";
}

<main>
    <!-- Hero Section -->
    <section class="fragrance-hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-tagline">Eaux de Parfum</span>
            <h1 class="hero-title">Fragrances that stir the imagination</h1>
            <p class="hero-description">
                Our collection of transportive fragrances—each a story waiting to be told. From
                citrus freshness to woody depths, discover scents that resonate.
            </p>
            <a href="#" class="hero-btn">Explore the collection <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
    </section>

    <!-- New Fragrances -->
    <section class="new-fragrances">
        <div class="container">
            <div class="section-header">
                <span class="section-subtitle">New additions</span>
                <h2 class="section-title">Recently introduced</h2>
            </div>
            <div class="fragrance-grid">
                @foreach (var item in Model)
                {
                    <div class="fragrance-card">
                        <div class="card-badge">New</div>
                        <div class="card-image">
                            <img src="./assets/images/@item.ImageURL" alt="Aurner Eau de Parfum" class="primary-img">
                            <img src="./assets/images/@item.SecondaryImageURL" alt="Aurner detail" class="hover-img">
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="card-content">
                            <h3>Aurner Eau de Parfum</h3>
                            <p class="notes">Magnolia Leaf, Roman Chamomile, Cedar Heart</p>
                            <span class="size">1.6 fl oz / 50 mL</span>
                            <p class="price">$200.00</p>
                        </div>
                        <button class="add-to-cart">Add to cart</button>
                    </div>
                }
                @* <div class="fragrance-card">
                    <div class="card-badge">New</div>
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Fragrance_Tacit_Eau_de_Parfum_100mL_Bottle_NGL_2000x2000px.png" alt="Aurner Eau de Parfum" class="primary-img">
                        <img src="./assets/images/Aesop_Fragrance_Rozu_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png" alt="Aurner detail" class="hover-img">
                        <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="card-content">
                        <h3>Aurner Eau de Parfum</h3>
                        <p class="notes">Magnolia Leaf, Roman Chamomile, Cedar Heart</p>
                        <span class="size">1.6 fl oz / 50 mL</span>
                        <p class="price">$200.00</p>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div>
                <div class="fragrance-card">
                    <div class="card-badge">New</div>
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Fragrance_Tacit_Eau_de_Parfum_100mL_Bottle_NGL_2000x2000px.png" alt="Above Us, Steorra" class="primary-img">
                        <img src="./assets/images/Aesop_Fragrance_Marrakech_Intense_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png" alt="Steorra detail" class="hover-img">
                        <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="card-content">
                        <h3>Above Us, Steorra</h3>
                        <p class="notes">Cardamom, Vanilla Bean, Frankincense</p>
                        <span class="size">1.6 fl oz / 50 mL</span>
                        <p class="price">$200.00</p>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div>
                <div class="fragrance-card">
                    <div class="card-badge">New</div>
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Fragrance_Tacit_Eau_de_Parfum_100mL_Bottle_NGL_2000x2000px.png" alt="Marrakech Intense" class="primary-img">
                        <img src="./assets/images/Aesop_Fragrance_Aurner_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (2).png" alt="Marrakech detail"
                             class="hover-img">
                        <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="card-content">
                        <h3>Marrakech Intense</h3>
                        <p class="notes">Spices, Woods, Musk</p>
                        <span class="size">1.6 fl oz / 50 mL</span>
                        <p class="price">$185.00</p>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div> *@
            </div>
        </div>
    </section>

    <!-- Fragrance Families -->
    <section class="fragrance-families">
        <div class="container">
            <div class="families-header">
                <h2>Explore by fragrance family</h2>
            </div>
            <div class="families-grid">
                <div class="family-card">
                    <img src="./assets/images/Aesop_Fragrance_2024_Web_Category_Page_Secondary_Menu_Opulent_Desktop_640x500.jpg" alt="Citrus">
                    <span>Citrus</span>
                </div>
                <div class="family-card">
                    <img src="./assets/images/Aesop_Fragrance_2024_Web_Category_Page_Secondary_Menu_Floral_Desktop_640x500.jpg" alt="Woody">
                    <span>Woody</span>
                </div>
                <div class="family-card">
                    <img src="./assets/images/Aesop_Fragrance_2024_Web_Category_Page_Secondary_Menu_Woody_Desktop_640x500.jpg" alt="Floral">
                    <span>Floral</span>
                </div>
                <div class="family-card">
                    <img src="./assets/images/Aesop_Fragrance_2024_Web_Category_Page_Secondary_Menu_Fresh_Desktop_640x500.jpg" alt="Spicy">
                    <span>Spicy</span>
                </div>
                <div class="family-card">
                    <img src="./assets/images/2006.133.128-list.webp" alt="Herbal">
                    <span>Herbal</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Signature Collection -->
    <section class="signature-collection">
        <div class="collection-container">
            <div class="collection-content">
                <span class="collection-label">The Signature Collection</span>
                <h2 class="collection-title">Enduring classics, reimagined</h2>
                <p class="collection-description">
                    Our most beloved fragrances—each composed with meticulous attention to
                    detail, offering a distinct olfactory identity that lingers.
                </p>
                <a href="#" class="collection-link">Discover the collection <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="collection-image">
                <img src="./assets/images/Aesop_Category_Page_Fragrance_Secondary_3_Armoire_Mobile_900x900px.jpg" alt="Signature fragrance collection">
            </div>
        </div>
    </section>

    <!-- Fragrance Products Grid -->
    <section class="fragrance-products">
        <div class="products-container">
            <div class="products-grid">
                <!-- Product 1 -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/Aesop_Fragrance_Rozu_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png" alt="Tacit Eau de Parfum" class="main-img">
                        <img src="./assets/images/Aesop_Fragrance_Rozu_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png" alt="Tacit detail" class="hover-img">
                        <button class="bookmark-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="product-info">
                        <h3>Tacit Eau de Parfum</h3>
                        <p class="product-notes">Yuzu, Basil, Cedarwood</p>
                        <div class="product-meta">
                            <span>1.6 fl oz</span>
                            <span class="divider"></span>
                            <span>50 mL</span>
                        </div>
                        <p class="product-price">$175.00</p>
                    </div>
                    <button class="add-to-cart-btn">Add to cart</button>
                </div>
                <!-- Product 2 -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/Aesop_Fragrance_Marrakech_Intense_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png" alt="Rozu Eau de Parfum" class="main-img">
                        <img src="./assets/images/Aesop_Fragrance_Marrakech_Intense_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px.png" alt="Rozu detail" class="hover-img">
                        <button class="bookmark-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="product-info">
                        <h3>Rozu Eau de Parfum</h3>
                        <p class="product-notes">Rose, Cypress, Amber</p>
                        <div class="product-meta">
                            <span>1.6 fl oz</span>
                            <span class="divider"></span>
                            <span>50 mL</span>
                        </div>
                        <p class="product-price">$185.00</p>
                    </div>
                    <button class="add-to-cart-btn">Add to cart</button>
                </div>
                <!-- Product 3 -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/Aesop_Fragrance_Aurner_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (2).png" alt="Hwyl Eau de Parfum" class="main-img">
                        <img src="./assets/images/Aesop_Fragrance_Aurner_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (2).png" alt="Hwyl detail" class="hover-img">
                        <button class="bookmark-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="product-info">
                        <h3>Hwyl Eau de Parfum</h3>
                        <p class="product-notes">Cypress, Vetiver, Moss</p>
                        <div class="product-meta">
                            <span>1.6 fl oz</span>
                            <span class="divider"></span>
                            <span>50 mL</span>
                        </div>
                        <p class="product-price">$185.00</p>
                    </div>
                    <button class="add-to-cart-btn">Add to cart</button>
                </div>
                <!-- Product 4 -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/Aesop_Fragrance_Tacit_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (1).png" alt="Erémia Eau de Parfum" class="main-img">
                        <img src="./assets/images/Aesop_Fragrance_Tacit_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (1).png" alt="Erémia detail" class="hover-img">
                        <button class="bookmark-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="product-info">
                        <h3>Erémia Eau de Parfum</h3>
                        <p class="product-notes">Bergamot, Galbanum, Musk</p>
                        <div class="product-meta">
                            <span>1.6 fl oz</span>
                            <span class="divider"></span>
                            <span>50 mL</span>
                        </div>
                        <p class="product-price">$175.00</p>
                    </div>
                    <button class="add-to-cart-btn">Add to cart</button>
                </div>
                <!-- Product 5 -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/Aesop_Fragrance_Eidesis_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (1).png" alt="Karst Eau de Parfum" class="main-img">
                        <img src="./assets/images/Aesop_Fragrance_Eidesis_Eau_de_Parfum_50mL_Bottle_with_Carton_NGL_2000x2000px (1).png" alt="Karst detail" class="hover-img">
                        <button class="bookmark-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="product-info">
                        <h3>Karst Eau de Parfum</h3>
                        <p class="product-notes">Sea Salt, Mineral Accord, Vetiver</p>
                        <div class="product-meta">
                            <span>1.6 fl oz</span>
                            <span class="divider"></span>
                            <span>50 mL</span>
                        </div>
                        <p class="product-price">$185.00</p>
                    </div>
                    <button class="add-to-cart-btn">Add to cart</button>
                </div>
                <!-- Product 6 -->
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/Aesop_Fragrance_Above_Us_Steorra_50mL_NGL_Front_2000x2000px.png" alt="Miraceti Eau de Parfum" class="main-img">
                        <img src="./assets/images/Aesop_Fragrance_Above_Us_Steorra_50mL_NGL_Front_2000x2000px.png" alt="Miraceti detail" class="hover-img">
                        <button class="bookmark-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="product-info">
                        <h3>Miraceti Eau de Parfum</h3>
                        <p class="product-notes">Patchouli, Labdanum, Styrax</p>
                        <div class="product-meta">
                            <span>1.6 fl oz</span>
                            <span class="divider"></span>
                            <span>50 mL</span>
                        </div>
                        <p class="product-price">$200.00</p>
                    </div>
                    <button class="add-to-cart-btn">Add to cart</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Home Fragrances -->
    <section class="home-fragrances">
        <div class="home-container">
            <div class="home-content">
                <span class="home-label">For the home</span>
                <h2 class="home-title">Scents that transform spaces</h2>
                <p class="home-description">
                    Our candles, room sprays, and incense bring the same olfactory rigor to your
                    living environment—creating atmospheres of calm and contemplation.
                </p>
                <a href="#" class="home-link">Explore home fragrances <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="home-grid">
                <div class="home-card">
                    <img src="./assets/images/woody.png" alt="Ptolemy Candle">
                    <h4>Ptolemy Candle</h4>
                    <p>Cypress, Vetiver, Moss</p>
                    <span class="home-price">$95.00</span>
                </div>
                <div class="home-card">
                    <img src="./assets/images/ambery.png" alt="Hestia Candle">
                    <h4>Hestia Candle</h4>
                    <p>Tabacco, Honey, Clove</p>
                    <span class="home-price">$95.00</span>
                </div>
                <div class="home-card">
                    <img src="./assets/images/marine.png" alt="Incense">
                    <h4>Aromatique Incense</h4>
                    <p>Woody, Spicy, Resinous</p>
                    <span class="home-price">$49.00</span>
                </div>
            </div>
        </div>
    </section>

    <!-- The Perfumer's Note -->
    <section class="perfumer-note">
        <div class="note-container">
            <div class="note-quote">
                <blockquote>
                    “A fragrance is not merely a scent—it is an invitation to journey inward, to recall a memory, to
                    imagine
                    a place never visited.”
                </blockquote>
                <cite>— Barnabé Fillion, Perfumer</cite>
            </div>
        </div>
    </section>

    <!-- Recommended Reading -->
    <section class="fragrance-reading">
        <div class="reading-container">
            <h2 class="reading-title">From the library</h2>
            <div class="reading-grid">
                <article class="reading-card">
                    <div class="card-image">
                        <img src="./assets/images/Aesop_NGL_Athenaeum_Thumbnail_A_History_of_Fragrance_Mobile_1080x800px.jpg" alt="The poetry of scent">
                    </div>
                    <div class="card-content">
                        <span class="card-category">Literature</span>
                        <h3>The poetry of scent: Notes on composition</h3>
                        <span class="read-time">5-minute read</span>
                    </div>
                </article>
                <article class="reading-card">
                    <div class="card-image">
                        <img src="./assets/images/Aesop_NGL_Athenaeum_Thumbnail_A_Guide_to_Fragrance_Mobile_1080x800px.jpg" alt="Fragrance and memory">
                    </div>
                    <div class="card-content">
                        <span class="card-category">Culture</span>
                        <h3>Fragrance and memory: The Proustian phenomenon</h3>
                        <span class="read-time">8-minute read</span>
                    </div>
                </article>
                <article class="reading-card">
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Above_Us_Steorra_2025_Web_Athenaeum_Thumbnail_540x400.jpg" alt="Natural ingredients">
                    </div>
                    <div class="card-content">
                        <span class="card-category">Lessons from the lab</span>
                        <h3>Sourcing the world's finest raw materials</h3>
                        <span class="read-time">12-minute read</span>
                    </div>
                </article>
            </div>
        </div>
    </section>
</main>
