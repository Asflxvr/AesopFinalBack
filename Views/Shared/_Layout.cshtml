    <script src="./assets/js/browse.js"></script>
    <script src="./assets/js/drop.js"></script>
    <script src="./assets/js/fullvideo.js"></script>
    <script>
        // Sepet API URL
        const cartApiUrl = '/api/cartapi';

        // Sepet durumu
        let cart = {
            items: [],
            total: 0
        };

        // Sayfa yüklendiğinde
        document.addEventListener('DOMContentLoaded', function() {
            loadCart();
            setupCartToggle();
            setupAddToCartButtons();
        });

        // Sepeti yükle
        async function loadCart() {
            try {
                const response = await fetch(cartApiUrl);
                const data = await response.json();
                cart = data;
                updateCartUI();
            } catch (error) {
                console.error('Cart load error:', error);
            }
        }

        // Sepet toggle
        function setupCartToggle() {
            const toggle = document.getElementById('cartToggle');
            const dropdown = document.getElementById('cartDropdown');

            toggle.addEventListener('click', (e) => {
                e.preventDefault();
                dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
            });

            // Dışarı tıklanınca kapat
            document.addEventListener('click', (e) => {
                if (!toggle.contains(e.target) && !dropdown.contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });
        }

        // Add to cart butonlarını ayarla
        function setupAddToCartButtons() {
            document.querySelectorAll('.add-to-cart, .add-to-cart-btn, .buy-button, .add-btn').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();

                    // Ürün kartını bul
                    const card = this.closest('.product-card, .product-item, .candle-card, .set-card, .blend-card');
                    if (!card) return;

                    // Ürün bilgilerini topla
                    const item = extractProductInfo(card);

                    // Sepete ekle
                    await addToCart(item, this);
                });
            });
        }

        // Ürün bilgilerini çıkar
        function extractProductInfo(card) {
            const item = {
                id: card.dataset.id || generateId(),
                name: '',
                price: 0,
                size: 'One size',
                imageUrl: '',
                quantity: 1
            };

            // İsim
            const titleEl = card.querySelector('h3, .product-name, .item-name, .title');
            if (titleEl) item.name = titleEl.textContent.trim();

            // Fiyat
            const priceEl = card.querySelector('.price, .product-price, .item-price, .cost');
            if (priceEl) {
                const priceText = priceEl.textContent.replace(/[^0-9.]/g, '');
                item.price = parseFloat(priceText) || 0;
            }

            // Resim
            const imgEl = card.querySelector('img');
            if (imgEl) item.imageUrl = imgEl.src;

            // Size dropdown varsa
            const sizeSelect = card.querySelector('select.size-select, .size-dropdown select');
            if (sizeSelect && sizeSelect.value) {
                item.size = sizeSelect.options[sizeSelect.selectedIndex]?.text || 'One size';
            }

            return item;
        }

        // Sepete ekle
        async function addToCart(item, button) {
            // Loading state
            button.classList.add('loading');
            button.disabled = true;

            try {
                const response = await fetch(`${cartApiUrl}/add`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(item)
                });

                const data = await response.json();

                if (data.success) {
                    // Sepeti güncelle
                    cart.items = data.items || [];
                    cart.total = data.total || 0;
                    updateCartUI();

                    // Başarılı mesajı göster
                    showToast(data.message, 'success');
                }
            } catch (error) {
                console.error('Add to cart error:', error);
                showToast('Error adding to cart', 'error');
            } finally {
                button.classList.remove('loading');
                button.disabled = false;
            }
        }

        // Sepetten çıkar
        async function removeFromCart(item) {
            try {
                const response = await fetch(`${cartApiUrl}/remove`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(item)
                });

                const data = await response.json();

                if (data.success) {
                    await loadCart();
                    showToast('Item removed from cart', 'success');
                }
            } catch (error) {
                console.error('Remove error:', error);
            }
        }

        // Miktar güncelle
        async function updateQuantity(item, quantity) {
            try {
                const response = await fetch(`${cartApiUrl}/update`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        id: item.id,
                        size: item.size,
                        quantity: quantity
                    })
                });

                const data = await response.json();

                if (data.success) {
                    await loadCart();
                }
            } catch (error) {
                console.error('Update error:', error);
            }
        }

        // Sepet UI'ını güncelle
        function updateCartUI() {
            const cartCount = document.getElementById('cartCount');
            const cartItems = document.getElementById('cartItems');
            const cartTotal = document.getElementById('cartTotal');
            const cartItemCount = document.getElementById('cartItemCount');

            const totalItems = cart.items?.reduce((sum, item) => sum + (item.quantity || 1), 0) || 0;

            // Sepet sayısı
            if (totalItems > 0) {
                cartCount.textContent = totalItems;
                cartCount.style.display = 'flex';
            } else {
                cartCount.style.display = 'none';
            }

            // Sepet öğeleri
            if (cartItems) {
                if (cart.items && cart.items.length > 0) {
                    cartItems.innerHTML = cart.items.map(item => `
                        <div class="cart-item" data-id="${item.id}" data-size="${item.size}">
                            <img src="${item.imageUrl || '/assets/images/placeholder.jpg'}" alt="${item.name}">
                            <div class="cart-item-info">
                                <div class="cart-item-name">${item.name}</div>
                                <div class="cart-item-details">${item.size} × ${item.quantity}</div>
                                <div class="cart-item-price">$${(item.price * (item.quantity || 1)).toFixed(2)}</div>
                            </div>
                            <div class="cart-item-remove" onclick="removeFromCart(${JSON.stringify(item).replace(/"/g, '&quot;')})">
                                <i class="fa-regular fa-trash-can"></i>
                            </div>
                        </div>
                    `).join('');
                } else {
                    cartItems.innerHTML = '<div class="empty-cart">Your cart is empty</div>';
                }
            }

            // Toplam
            if (cartTotal) {
                cartTotal.textContent = `$${(cart.total || 0).toFixed(2)}`;
            }

            // Ürün sayısı
            if (cartItemCount) {
                cartItemCount.textContent = `${totalItems} item${totalItems !== 1 ? 's' : ''}`;
            }
        }

        // Toast bildirimi
        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = `toast-notification ${type}`;
            toast.innerHTML = `
                <i class="fa-${type === 'success' ? 'regular' : 'solid'} fa-circle-${type === 'success' ? 'check' : 'exclamation'}"></i>
                <span>${message}</span>
            `;

            toast.style.cssText = `
                position: fixed;
                top: 100px;
                right: 30px;
                background: ${type === 'success' ? '#333' : '#ff4444'};
                color: white;
                padding: 12px 20px;
                border-radius: 4px;
                font-size: 14px;
                z-index: 2000;
                animation: slideIn 0.3s ease;
                display: flex;
                align-items: center;
                gap: 10px;
            `;

            document.body.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ID generate
        function generateId() {
            return Date.now().toString(36) + Math.random().toString(36).substr(2);
        }

        // Animasyonlar
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateX(100%);
                }
                to {
                    opacity: 1;
                    transform: translateX(0);
                }
            }

            @@keyframes slideOut {
                from {
                    opacity: 1;
                    transform: translateX(0);
                }
                to {
                    opacity: 0;
                    transform: translateX(100%);
                }
            }
        `;
        document.head.appendChild(style);</script>
</body>

