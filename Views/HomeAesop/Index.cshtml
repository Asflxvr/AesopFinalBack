@model IEnumerable<Product>
@{
	Layout = "_Layout";
}


<main class="home-main">

    <!-- 1. HERO SECTION - HOME -->
    <section class="home-hero">
        <div class="hero-background">
            <img src="./assets/images/Aesop_Scents_2026_Web_Navigation_Desktop_US_440x330px.jpg" alt="Aesop home fragrances" class="hero-image">
            <div class="overlay"></div>
        </div>
        <div class="hero-content">
            <div class="hero-text-wrapper">
                <span class="hero-mini-title">For the home</span>
                <h1 class="hero-main-title">Fragrance for living spaces</h1>
                <p class="hero-description">
                    Candles, room sprays, and incense—each designed to transform the
                    atmosphere of a room, inviting calm and contemplation.
                </p>
                <div class="hero-buttons">
                    <a href="#" class="hero-btn primary">
                        Explore collection <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="#" class="hero-btn secondary">Find a store <i class="fa-solid fa-location-dot"></i></a>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. CANDLES COLLECTION - ŞAM KOLLEKSİYONU -->
    <section class="candles-collection">
        <div class="container">
            <div class="section-header">
                <span class="section-subtitle">Illumination</span>
                <h2 class="section-title">Aromatique candles</h2>
                <p class="section-description">
                    Each candle is housed in a apothecary-inspired vessel, crafted from
                    amber glass to protect the fragrance from light.
                </p>
            </div>
            <div class="candles-grid">
                <div class="candle-card">
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Home_Callippus_Aromatique_Candle_Vessel_&_Carton_Front_2000x2000px.png" alt="Ptolemy Candle">
                        <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="card-content">
                        <h3>Ptolemy</h3>
                        <p class="candle-notes">Cypress, Vetiver, Moss</p>
                        <div class="candle-details">
                            <span class="weight">300 g</span>
                            <span class="burn-time">~70 hours</span>
                        </div>
                        <span class="price">$95.00</span>
                    </div>
                    <button class="add-to-cart buy-button">Add to cart</button>
                </div>
                <div class="candle-card">
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Home_Ptolemy_Aromatique_Candle_Web_Front_2000x2000px.png" alt="Hestia Candle">
                        <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="card-content">
                        <h3>Hestia</h3>
                        <p class="candle-notes">Tobacco, Honey, Clove</p>
                        <div class="candle-details">
                            <span class="weight">300 g</span>
                            <span class="burn-time">~70 hours</span>
                        </div>
                        <span class="price">$95.00</span>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div>
                <div class="candle-card">
                    <div class="card-image">
                        <img src="./assets/images/Aesop_Home_Sarashina_Aromatique_Incense_Web_Front_2000x2000px.png" alt="Calliope Candle">
                        <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                    </div>
                    <div class="card-content">
                        <h3>Calliope</h3>
                        <p class="candle-notes">Geranium, Mandarin, Jasmine</p>
                        <div class="candle-details">
                            <span class="weight">300 g</span>
                            <span class="burn-time">~70 hours</span>
                        </div>
                        <span class="price">$95.00</span>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. ROOM SPRAYS & INCENSE - OTAQ SPREYLƏRİ -->
    <section class="ambience-section">
        <div class="ambience-container">
            <div class="ambience-image">
                <img src="./assets/images/Aesop_Top_20_2025_PDP_Application_Incense_2000x2000px (1).png" alt="Room spray">
            </div>
            <div class="ambience-content">
                <span class="ambience-tagline">Instant atmosphere</span>
                <h2>Room sprays & incense</h2>
                <p>
                    For moments when an immediate transformation is desired—a spritz of room spray or the slow burn
                    of incense can alter the mood of a space entirely.
                </p>

                <div class="ambience-grid">
                    <div class="ambience-item">
                        <img src="./assets/images/Aesop_Home_Sarashina_Aromatique_Incense_Web_Front_2000x2000px (1).png" alt="Istros">
                        <div class="item-info">
                            <h4>Istros Room Spray</h4>
                            <p>Tobacco, Honey, Clove</p>
                            <span class="item-price">$65.00</span>
                        </div>
                        <button class="item-add"><i class="fa-solid fa-plus"></i></button>
                    </div>
                    <div class="ambience-item">
                        <img src="./assets/images/Aesop_Category_Page_Home_Subcat_Menu_Design_Objects_1080x1080px.jpg" alt="Olous">
                        <div class="item-info">
                            <h4>Olous Room Spray</h4>
                            <p>Mint, Rosemary, Lavender</p>
                            <span class="item-price">$65.00</span>
                        </div>
                        <button class="item-add"><i class="fa-solid fa-plus"></i></button>
                    </div>
                    <div class="ambience-item">
                        <img src="./assets/images/Aesop_Scented_Home_Web_Secondary_Incense.jpg" alt="Incense">
                        <div class="item-info">
                            <h4>Aromatique Incense</h4>
                            <p>Woody, Spicy, Resinous</p>
                            <span class="item-price">$49.00</span>
                        </div>
                        <button class="item-add"><i class="fa-solid fa-plus"></i></button>
                    </div>
                </div>

                <a href="#" class="ambience-link">
                    Explore all home fragrances <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- 4. OIL BURNER BLENDS - YAĞ YANDIRICILAR -->
    <section class="oil-blends">
        <div class="container">
            <div class="blends-header">
                <span class="blends-subtitle">Oil burner blends</span>
                <h2>For the ceramic burner</h2>
            </div>
            <div class="blends-grid">
                @foreach (var item in Model)
                {
                    <div class="blend-card">
                        <div class="blend-image">
                            <img src="~/assets/images/@item.ImageURL" alt="Oil blend">
                        </div>
                        <h3>@item.Title</h3>
                        <p class="blend-notes">@item.Description</p>
                        <span class="blend-price">$@item.Price</span>
                        <button class="blend-add">Add</button>
                    </div>
                }
                @* <div class="blend-card">
                    <div class="blend-image">
                        <img src="./assets/images/Aesop_Category_Page_Fragrance_Secondary_3_Armoire_Mobile_900x900px.jpg" alt="Oil blend">
                    </div>
                    <h3>Athenaeum</h3>
                    <p class="blend-notes">Cedar, Vetiver, Frankincense</p>
                    <span class="blend-price">$42.00</span>
                    <button class="blend-add">Add</button>
                </div>

                <div class="blend-card">
                    <div class="blend-image">
                        <img src="./assets/images/Aesop_Home_Cythera_Aromatique_Room_Spray_100mL_Web_Front_2000x2000px (1).png" alt="Oil blend">
                    </div>
                    <h3>Muse</h3>
                    <p class="blend-notes">Geranium, Jasmine, Patchouli</p>
                    <span class="blend-price">$42.00</span>
                    <button class="blend-add">Add</button>
                </div>

                <div class="blend-card">
                    <div class="blend-image">
                        <img src="./assets/images/Aesop Corporate Gifts (1).png" alt="Oil blend">
                    </div>
                    <h3>Sacred</h3>
                    <p class="blend-notes">Myrrh, Sandalwood, Benzoin</p>
                    <span class="blend-price">$45.00</span>
                    <button class="blend-add">Add</button>
                </div> *@

            </div>
        </div>
    </section>

    <!-- 5. CERAMIC COLLECTION - SERAMİK MƏHSULLAR -->
    <section class="ceramic-collection">
        <div class="ceramic-container">
            <div class="ceramic-content">
                <span class="ceramic-label">Vessels & objects</span>
                <h2>Ceramic burner</h2>
                <p>
                    A sculptural object for the home, designed to accompany our oil burner blends. Each piece is
                    crafted by artisans and unique in its finish.
                </p>
                <div class="ceramic-price">$185.00</div>
                <a href="#" class="ceramic-link">Learn more <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="ceramic-image">
                <img src="./assets/images/Aesop_Category_Page_All_Secondary_Assistance_Mobile_640x640px.jpg" alt="Ceramic burner">
            </div>
        </div>
    </section>

</main>
