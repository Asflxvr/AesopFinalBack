
@{
	Layout = "_Layout";
}


<main>
    <!-- experience -->
    <!-- 1. EXPERIENCE HERO -->
    <section class="experience-hero">
        <div class="hero-background">
            <img src="./assets/images/Aesop_Experience_Page_Primary_Mobile_1088x1088px.jpg" alt="Aesop Experience">
            <div class="overlay"></div>
        </div>
        <div class="hero-content">
            <span class="hero-tagline">Sensory journeys</span>
            <h1 class="hero-title">Beyond the product</h1>
            <p class="hero-description">
                Immersive experiences that invite exploration—from store consultations to
                olfactory
                discoveries and cultural collaborations.
            </p>
            <a href="#" class="hero-btn">Discover experiences <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
    </section>

    <!-- 2. STORE EXPERIENCES -->
    <section class="store-experiences">
        <div class="container">
            <div class="section-header">
                <h2>Store experiences</h2>
                <p>Personalised consultations in spaces designed for discovery</p>
            </div>
            <div class="stores-grid">
                <div class="store-card">
                    <div class="store-image">
                        <img src="./assets/images/Aesop_Experience_Page_Secondary_1_Corporate_Gifting_Mid_Mobile_900x900px.jpg" alt="Facial Consultation">
                        <div class="store-overlay">
                            <span class="store-duration">60 minutes</span>
                        </div>
                    </div>
                    <div class="store-content">
                        <h3>Facial consultation</h3>
                        <p class="store-desc">
                            A one-on-one session with a trained consultant to explore formulations
                            suited
                            to your skin's needs.
                        </p>
                        <div class="store-meta">
                            <span class="store-location">All stores</span>
                            <a href="#" class="store-link">Book now <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="store-card">
                    <div class="store-image">
                        <img src="./assets/images/Aesop boxes.png" alt="Fragrance Consultation">
                        <div class="store-overlay">
                            <span class="store-duration">45 minutes</span>
                        </div>
                    </div>
                    <div class="store-content">
                        <h3>Fragrance discovery</h3>
                        <p class="store-desc">
                            An guided exploration of our Eaux de Parfum, helping you find a scent that
                            resonates.
                        </p>
                        <div class="store-meta">
                            <span class="store-location">Select stores</span>
                            <a href="#" class="store-link">Book now <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="store-card">
                    <div class="store-image">
                        <img src="./assets/images/Aesop_Above_Us_Steorra_2025_Web_Athenaeum_Thumbnail_540x400.jpg" alt="Gift Consultation">
                        <div class="store-overlay">
                            <span class="store-duration">30 minutes</span>
                        </div>
                    </div>
                    <div class="store-content">
                        <h3>Gift guidance</h3>
                        <p class="store-desc">
                            Personalised recommendations for gifting, with complimentary wrapping
                            service.
                        </p>
                        <div class="store-meta">
                            <span class="store-location">All stores</span>
                            <a href="#" class="store-link">Book now <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. CULTURAL COLLABORATIONS -->
    <section class="cultural-collaborations">
        <div class="container">
            <div class="collab-header">
                <span class="collab-subtitle">Cultural program</span>
                <h2>Collaborations & installations</h2>
                <p class="collab-description">
                    Exploring the intersection of scent with art, architecture, and literature
                    through temporary installations and ongoing partnerships.
                </p>
            </div>
            <div class="collab-grid">
                <div class="collab-card featured">
                    <div class="collab-image">
                        <img src="./assets/images/75f181da26df41e000f94fe2d1b44510-mobile.jpg" alt="Featured collaboration">
                    </div>
                    <div class="collab-content">
                        <span class="collab-date">March - June 2026</span>
                        <h3>An olfactory library</h3>
                        <p class="collab-text">
                            A temporary installation at the Melbourne Athenaeum, exploring the
                            relationship between scent and memory through archived formulations.
                        </p>
                        <a href="#" class="collab-link">Learn more <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="collab-card">
                    <div class="collab-image">
                        <img src="./assets/images/a5403a80691363d81543860141127dea-mobile.jpg" alt="Tokyo installation">
                    </div>
                    <div class="collab-content">
                        <span class="collab-date">April 2026</span>
                        <h3>Tokyo: Sensory spaces</h3>
                        <p class="collab-text">
                            A collaboration with architect Kengo Kuma on a temporary retail space in
                            Aoyama.
                        </p>
                        <a href="#" class="collab-link">Learn more <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="collab-card">
                    <div class="collab-image">
                        <img src="./assets/images/a745e52456d988dfef7759dd49533f7b-mobile.jpg" alt="Paris installation">
                    </div>
                    <div class="collab-content">
                        <span class="collab-date">May 2026</span>
                        <h3>Paris: Scent and sound</h3>
                        <p class="collab-text">
                            An immersive experience pairing fragrances with contemporary musical
                            compositions.
                        </p>
                        <a href="#" class="collab-link">Learn more <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
