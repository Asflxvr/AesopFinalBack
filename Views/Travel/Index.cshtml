@model IEnumerable<Product>
@{
    Layout = "_SecondaryLayout";
}

<main>
    <section class="discover-travel-banner">
        <div class="banner-overlay">
            <div class="banner-content">
                <h1 class="banner-title">Travel</h1>
                <p class="banner-subtitle">
                    A collection of pocket-sized saviours and indispensable daily
                    formulations-for
                    use on journeys around the corner or around the globe.
                </p>
            </div>
        </div>
    </section>
    <!-- travelkard -->
    <section class="travel-collection">
        <div class="travel-grid">
            <div class="travel-item">
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Category_Page_Travel_Subcat_Menu_In-flight_Essentials_1080x1080px.jpg"
                         alt="In-flight essentials">
                </div>
                <h3 class="item-title">In-flight essentials</h3>
            </div>

            <div class="travel-item">
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Category_Page_Travel_Subcat_Menu_For_the_Commute_1080x1080px.jpg"
                         alt="For the commute">
                </div>
                <h3 class="item-title">For the commute</h3>
            </div>

            <div class="travel-item">
                <div class="image-wrapper">
                    <img src="./assets/images/Aesop_Category_Page_Travel_Subcat_Menu_Travel_Kits_1080x1080px.jpg"
                         alt="Travel Kits">
                </div>
                <h3 class="item-title">Travel Kits</h3>
            </div>
        </div>
    </section>
    <!-- outof -->
    <section class="office-necessities">
        <div class="section-header">
            <h2 class="section-title">Office necessities</h2>
            <p class="section-subtitle">When the desk is your destination.</p>
        </div>

        <div class="product-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image">
                        <img src="./assets/images/@item.ImageURL"
                             alt="Hydrosol">
                        <button class="bookmark-btn">
                            <svg width="14" height="19" viewBox="0 0 14 19" fill="none">
                                <path d="M1 1V17L7 13L13 17V1H1Z" stroke="black" />
                            </svg>
                        </button>
                    </div>
                    <div class="product-info">
                        <h3 class="product-name">@item.Title</h3>
                        <p class="product-desc">@item.Description</p>
                        <span class="product-price">@item.Price</span>
                    </div>
                    <button class="add-to-cart">Add to cart</button>
                </div>
            }

        </div>
    </section>
    <!-- find -->
    <section class="airport-discovery">
        <div class="discovery-container">
            <div class="discovery-image">
                <img src="./assets/images/Aesop_Category_Page_Travel_Secondary_2_Airport_2560x1540px.jpg"
                     alt="Aesop Airport Store">
            </div>

            <div class="discovery-content">
                <div class="content-wrapper">
                    <h2 class="discovery-title">Discover Aesop at the airport</h2>
                    <p class="discovery-text">
                        Our airport stores are situated in select terminals around the world, offering the perfect
                        opportunity to purchase last-minute carry-on essentials and gifts, or enjoy a refreshing hot towel
                        or cup of tea.
                    </p>
                    <a href="#" class="discovery-btn">
                        Find an airport store
                        <span class="arrow">→</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <!-- face -->
    <section class="assistance-section">
        <div class="assistance-container">
            <div class="info-content">
                <h2 class="title">For additional assistance</h2>
                <p class="description">
                    If you could use some guidance finding the ideal formulation for your individual needs,
                    our consultants are available to help at a distance.
                </p>
                <a href="#" class="consult-btn">
                    Speak to a real consultant <span class="arrow">→</span>
                </a>
            </div>

            <div class="image-box">
                <img src="./assets/images/Aesop_Category_Page_All_Secondary_3_Assistance_Mobile_640x640px.jpg"
                     alt="Skincare Consultation" class="consultant-img">
            </div>
        </div>
    </section>
</main>
