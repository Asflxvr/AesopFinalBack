@model IEnumerable<Product>
@{
	Layout = "_Layout";
}


<main>
    <!-- gifts -->
    <section class="gifts-hero">
        <div class="hero-background">
            <img src="./assets/images/Aesop_Festive_2025_NGL_Category_Page_Gifts_Secondary_Banner_Seasonal_Kits_GL_Mobile_900x506px.jpg.jpg" alt="Aesop gifts">
            <div class="overlay"></div>
        </div>
        <div class="hero-content">
            <span class="hero-tagline">Considered giving</span>
            <h1 class="hero-title">Gifts that speak volumes</h1>
            <p class="hero-description">
                Each formulation is a gesture—an expression of thoughtfulness, presented with
                the
                same care with which it was created.
            </p>
            <a href="#" class="hero-btn">Explore gifts <i class="fa-solid fa-arrow-right-long"></i></a>
        </div>
    </section>

    <!-- 2. GIFT GUIDES -->
    <section class="gift-guides">
        <div class="container">
            <div class="guides-header">
                <h2>Gift guides</h2>
                <p>For every personality and preference</p>
            </div>
            <div class="guides-grid">
                <div class="guide-card">
                    <img src="./assets/images/Aesop_Kits_Aesop_Abode_NGL_In-Situ_Contents_US_CA_2000x2000px.png" alt="For her">
                    <div class="guide-overlay">
                        <h3>For her</h3>
                        <a href="#" class="guide-link">Discover <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="guide-card">
                    <img src="./assets/images/Aesop_Kits_Gift_Kits_2025-26_Shower_Room_Serenades_NGL_In-Situ_Product_GL_2000x2000px.png" alt="For him">
                    <div class="guide-overlay">
                        <h3>For him</h3>
                        <a href="#" class="guide-link">Discover <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="guide-card">
                    <img src="./assets/images/Aesop_Kits_Gift_Kits_2025-26_Party_in_the_Greenhouse_NGL_In-Situ_Product_GL_1_2000x2000px (1).png" alt="For the home">
                    <div class="guide-overlay">
                        <h3>For the home</h3>
                        <a href="#" class="guide-link">Discover <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="guide-card">
                    <img src="./assets/images/Aesop_Festive_2025_NGL_Category_Page_Gifts_Secondary_Banner_Fragrance_Mobile_900x506px.jpg" alt="For travel">
                    <div class="guide-overlay">
                        <h3>For travel</h3>
                        <a href="#" class="guide-link">Discover <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. GIFT SETS -->
    <section class="gift-sets">
        <div class="container">
            <div class="sets-header">
                <span class="sets-subtitle">Curated collections</span>
                <h2>Gift sets</h2>
            </div>
            <div class="sets-grid">
                @foreach(var item in Model)
                {
                    <div class="set-card">
                        <div class="set-image">
                            <img src="./assets/images/@item.ImageURL" alt="Resurrection Duet">
                            <span class="set-badge">Bestseller</span>
                            <button class="wishlist-btn"><i class="fa-regular fa-bookmark"></i></button>
                        </div>
                        <div class="set-content">
                            <h3>@item.Title</h3>
                            <p class="set-desc">@item.Description</p>
                            <div class="set-price">@item.Price</div>
                        </div>
                        <button class="add-to-cart">Add to cart</button>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- 4. GIFT WRAPPING -->
    <section class="gift-wrapping">
        <div class="wrapping-container">
            <div class="wrapping-image">
                <img src="./assets/images/Aesop_NGL_Athenaeum_Thumbnail_Sensorialist_Literature_Mobile_1080x800px (1).jpg" alt="Gift wrapping">
            </div>
            <div class="wrapping-content">
                <span class="wrapping-tagline">Complimentary service</span>
                <h2>Thoughtfully wrapped</h2>
                <p>
                    Each gift is carefully wrapped in our signature paper and secured with a cotton ribbon—a presentation
                    that reflects the care within.
                </p>
                <div class="wrapping-features">
                    <div class="feature">
                        <i class="fa-regular fa-square-check"></i>
                        <span>Signature paper wrapping</span>
                    </div>
                    <div class="feature">
                        <i class="fa-regular fa-square-check"></i>
                        <span>Cotton ribbon closure</span>
                    </div>
                    <div class="feature">
                        <i class="fa-regular fa-square-check"></i>
                        <span>Personalised message card</span>
                    </div>
                </div>
                <a href="#" class="wrapping-link">Learn more <i class="fa-solid fa-arrow-right"></i></a>
            </div>
        </div>
    </section>
</main>
