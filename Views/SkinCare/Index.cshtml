@model IEnumerable<Product>
@{
    Layout = "_SecondaryLayout";
}

<main>
    <!-- skincarehero -->
    <section class="hero-skincare">
        <div class="hero-container">
            <div class="hero-content">
                <h1 class="hero-title">Skin Care</h1>
                <p class="hero-description">
                    Skin is ever-changing-it responds to environment, lifestyle and diet.
                    Our range is designed with this in mind, catering to various needs and
                    preferences to guide you towards optimal skin health.
                </p>
            </div>
        </div>
    </section>
    <!-- skincarecard -->
    <section class="category-carousel">
        <div class="carousel-wrapper">
            <button class="arrow-btn prev" id="prevBtn"><i class="fa-solid fa-chevron-left"></i></button>

            <div class="carousel-viewport">
                <div class="carousel-list" id="carouselList">
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Cleansers_Exfoliants_1080x1080px.jpg"
                             alt="Cleansers">
                        <h4>Cleansers & Exfoliants</h4>
                    </div>
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Treats_Masques_1080x1080px.jpg"
                             alt="Treats">
                        <h4>Treats & Masques</h4>
                    </div>
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Toners_1080x1080px.jpg"
                             alt="Toners">
                        <h4>Toners</h4>
                    </div>
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Hydrators_Moisturisers_1080x1080px.jpg"
                             alt="Hydrators">
                        <h4>Hydrators & Moisturisers</h4>
                    </div>
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Eye_Lip_Care_1080x1080px.jpg"
                             alt="Eye">
                        <h4>Eye & Lip Care</h4>
                    </div>
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Shaving_1080x1080px.jpg"
                             alt="Shaving">
                        <h4>Shaving</h4>
                    </div>
                    <div class="category-card">
                        <img src="./assets/images/Aesop_Category_Page_Skin_Care_Subcat_Menu_Sun_Care_1080x1080px.jpg"
                             alt="Sun Care">
                        <h4>Sun Care</h4>
                    </div>
                </div>
            </div>

            <button class="arrow-btn next" id="nextBtn"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    </section>
    <!-- skincarecards -->
    <section class="new-notable">
        <div class="container">
            <div class="section-title">
                <h2>Recent additions and revered formulations</h2>
            </div>

            <div class="slider-wrapper">
                <button class="arrow prev" id="prevBtn"><i class="fa-solid fa-chevron-left"></i></button>

                <div class="product-list" id="slider">
                    @foreach (var item in Model)
                    {
                        <div class="product-card">
                            <div class="product-visual">
                                <img src="./assets/images/@item.ImageURL"
                                     class="img-base">
                                <img src="./assets/images/@item.SecondaryImageURL"
                                     class="img-reveal">
                                <button class="wish-icon"><i class="fa-regular fa-bookmark"></i></button>
                            </div>
                            <div class="product-details">
                                <h4>Parsley Seed Anti-Oxidant Serum</h4>
                                <p class="summary">For normal, combination and sensitive skin.</p>
                                <p class="cost">$95.00</p>
                            </div>
                            <button class="buy-button">Add to cart</button>
                        </div>
                    }
                    @* <div class="product-card">
                        <div class="product-visual">
                            <img src="./assets/images/Aesop_Skin_Parsley_Seed_Anti-Oxidant_Intense_Serum_60mL_Front_2000x2000px.png"
